{
  "extends": [
    "local>hmcts/.github:renovate-config",
    "local>hmcts/.github//renovate/automerge-all"
  ],
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "schedule": "before 6am every weekday",
  "packageRules": [
    {
      "description": "Keep Jenkins controller updates separate from the plugin updates",
      "matchManagers": ["dockerfile"],
      "groupName": "Jenkins controller"
    },
    {
      "description": "Keep Jenkins plugin updates separate from the controller image updates",
      "matchManagers": ["jenkins"],
      "groupName": "Jenkins plugins"
    }
  ]
}